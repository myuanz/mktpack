if(NOT DEFINED CPM_SOURCE_CACHE AND NOT DEFINED ENV{CPM_SOURCE_CACHE})
  if(DEFINED ENV{XDG_CACHE_HOME} AND NOT "$ENV{XDG_CACHE_HOME}" STREQUAL "")
    set(CPM_SOURCE_CACHE "$ENV{XDG_CACHE_HOME}/CPM" CACHE PATH "CPM 依赖源码缓存目录")
  else()
    set(CPM_SOURCE_CACHE "$ENV{HOME}/.cache/CPM" CACHE PATH "CPM 依赖源码缓存目录")
  endif()
endif()

# 获取固定版本的 CPM；下载内容由 SHA256 校验。
set(MKTPACK_CPM_FILE "${CMAKE_BINARY_DIR}/cmake/CPM-0.42.0.cmake")
set(MKTPACK_CPM_SHA256 "2020b4fc42dba44817983e06342e682ecfc3d2f484a581f11cc5731fbe4dce8a")
if(EXISTS "${MKTPACK_CPM_FILE}")
  file(SHA256 "${MKTPACK_CPM_FILE}" MKTPACK_CPM_CACHED_SHA256)
endif()
if(NOT MKTPACK_CPM_CACHED_SHA256 STREQUAL MKTPACK_CPM_SHA256)
  file(DOWNLOAD
    https://github.com/cpm-cmake/CPM.cmake/releases/download/v0.42.0/CPM.cmake
    "${MKTPACK_CPM_FILE}"
    EXPECTED_HASH "SHA256=${MKTPACK_CPM_SHA256}"
    TLS_VERIFY ON
  )
endif()
include("${MKTPACK_CPM_FILE}")
